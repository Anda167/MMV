BtnBg.MouseButton1Click:Connect(function()
    local gunDrop = Workspace:FindFirstChild("GunDrop") or Workspace:FindFirstChild("Gun")
    if not gunDrop then
        for _, child in ipairs(Workspace:GetChildren()) do
            if child.Name == "GunDrop" or (child:IsA("Tool") and child.Name == "Gun") then gunDrop = child break end
        end
    end
    if gunDrop and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local targetPos = gunDrop:IsA("Tool") and gunDrop.Handle.Position or gunDrop.Position
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
    end
end)
-- [[ ท่อนที่ 3: SYSTEM LOOPS ]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function GetPlayerRole(player)
    if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
        return "Murderer"
    elseif player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then
        return "Sheriff"
    else
        return "Innocent"
    end
end

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if shared.HitboxEnabled then
                    hrp.Size = Vector3.new(shared.HitboxSize, shared.HitboxSize, shared.HitboxSize)
                    hrp.Transparency = 0.7
                    hrp.BrickColor = BrickColor.new("Medium purple")
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.CanCollide = true
                end
            end
            
            local highlight = player.Character:FindFirstChildOfClass("Highlight")
            if shared.ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Parent = player.Character
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                end
                local role = GetPlayerRole(player)
                if role == "Murderer" then
                    highlight.FillColor = Color3.fromRGB(255, 50, 50)
                    highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
                elseif role == "Sheriff" then
                    highlight.FillColor = Color3.fromRGB(50, 150, 255)
                    highlight.OutlineColor = Color3.fromRGB(50, 150, 255)
                else
                    highlight.FillColor = Color3.fromRGB(80, 255, 80)
                    highlight.OutlineColor = Color3.fromRGB(80, 255, 80)
                end
            else
                if highlight then highlight:Destroy() end
            end
            
        end
    end
end)
