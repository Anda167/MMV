local function CreateToggle(name, default, callback)
    local state = default
    local ToggleBg = Instance.new("Frame")
    ToggleBg.Size = UDim2.new(1, 0, 0, 40)
    ToggleBg.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    ToggleBg.Parent = Content
    Instance.new("UICorner", ToggleBg).CornerRadius = UDim.new(0, 6)
    
    local Txt = Instance.new("TextLabel")
    Txt.Size = UDim2.new(0.7, 0, 1, 0)
    Txt.Position = UDim2.new(0, 12, 0, 0)
    Txt.BackgroundTransparency = 1
    Txt.Text = name
    Txt.TextColor3 = Color3.fromRGB(230, 230, 230)
    Txt.TextSize = 14
    Txt.Font = Enum.Font.GothamMedium
    Txt.TextXAlignment = Enum.TextXAlignment.Left
    Txt.Parent = ToggleBg
    
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 50, 0, 24)
    Btn.Position = UDim2.new(1, -62, 0, 8)
    Btn.BackgroundColor3 = state and Color3.fromRGB(140, 60, 220) or Color3.fromRGB(60, 60, 65)
    Btn.Text = state and "ON" or "OFF"
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 11
    Btn.Parent = ToggleBg
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)
    
    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.BackgroundColor3 = state and Color3.fromRGB(140, 60, 220) or Color3.fromRGB(60, 60, 65)
        Btn.Text = state and "ON" or "OFF"
        callback(state)
    end)
end

