-- ฟังก์ชันจำลองการคลิกหน้าจอด้วย VirtualUser (รองรับทุกตัวรัน)
local function SimulateClick()
    local VirtualUser = game:GetService("VirtualUser")
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0,0))
    wait(0.05)
    VirtualUser:Button1Up(Vector2.new(0,0))
end

RunService.RenderStepped:Connect(function()
    local murdererPlayer = nil
    
    -- ลูปเช็คบทบาทและทำ ESP
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local role = GetPlayerRole(player)
            
            if role == "Murderer" then
                murdererPlayer = player
            end
            
            -- บล็อกทำงาน ESP มองทะลุ
            local highlight = player.Character:FindFirstChildOfClass("Highlight")
            if shared.ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Parent = player.Character
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                end
                
                if role == "Murderer" then
                    highlight.FillColor = Color3.fromRGB(255, 50, 50)
                    highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
                elseif role == "Sheriff" then
                    highlight.FillColor = Color3.fromRGB(50, 150, 255)
                    highlight.OutlineColor = Color3.fromRGB(50, 150, 255)
                else
                    highlight.FillColor = Color3.fromRGB(80, 255, 80)
                    highlight.OutlineColor = Color3.fromRGB(80, 255, 80)
                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
    
    -- ลูประบบตรวจจับหน้าจอ + คลิกอัตโนมัติ (Triggerbot)
    if shared.AutoShootMurderer and murdererPlayer and murdererPlayer.Character and murdererPlayer.Character:FindFirstChild("Head") then
        local gun = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun"))
        
        -- จะทำงานเมื่อเราถือปืนอยู่เท่านั้น เพื่อไม่ให้ระบบกดคลิกมั่วซั่วตอนเป็นคนธรรมดา
        if LocalPlayer.Character:FindFirstChild("Gun") then
            local targetHead = murdererPlayer.Character.Head
            local vector, onScreen = Camera:WorldToScreenPoint(targetHead.Position)
            
            if onScreen then
                -- ตรวจสอบว่าเป้าเล็งตรงกลางหน้าจอ อยู่ใกล้ตำแหน่งหัวของฆาตกรหรือไม่
                local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local targetPos2D = Vector2.new(vector.X, vector.Y)
                local distance = (screenCenter - targetPos2D).Magnitude
                
                -- ระยะรัศมีเป้าเล็ง (หากฆาตกรผ่านเข้ามาในเป้ากลางจอระยะ 60 พิกเซล ระบบจะยิงทันที)
                if distance <= 60 then
                    task.spawn(SimulateClick)
                end
            end
        end
    end
end)
