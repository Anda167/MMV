local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = Workspace.CurrentCamera

local function GetPlayerRole(player)
    if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then
        return "Murderer"
    elseif player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then
        return "Sheriff"
    else
        return "Innocent"
    end
end

RunService.RenderStepped:Connect(function()
    local murdererPlayer = nil
    
    -- ลูปทำ ESP และค้นหาฆาตกรแบบ Real-time
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local role = GetPlayerRole(player)
            if role == "Murderer" then
                murdererPlayer = player
            end
            
            local highlight = player.Character:FindFirstChildOfClass("Highlight")
            if shared.ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Parent = player.Character
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                end
                
                if role == "Murderer" then
                    highlight.FillColor = Color3.fromRGB(255, 50, 50)
                    highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
                elseif role == "Sheriff" then
                    highlight.FillColor = Color3.fromRGB(50, 150, 255)
                    highlight.OutlineColor = Color3.fromRGB(50, 150, 255)
                else
                    highlight.FillColor = Color3.fromRGB(80, 255, 80)
                    highlight.OutlineColor = Color3.fromRGB(80, 255, 80)
                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
    
    -- ระบบ Aimbot ล็อคเป้าผ่านปุ่มกลไกกล้อง (เมื่อถือปืน + เปิด Shift Lock หรือหันไปใกล้)
    if shared.ShiftLockMurdAim and murdererPlayer and murdererPlayer.Character and murdererPlayer.Character:FindFirstChild("Head") then
        local hasGunOut = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun")
        local isShiftLockActive = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
        
        -- ล็อคเป้าทันทีเมื่อถือปืน และเปิดใช้งาน Shift Lock (หรือระบบ MouseBehavior ล็อคกลางจอ)
        if hasGunOut and isShiftLockActive then
            local targetHead = murdererPlayer.Character.Head
            
            -- ปรับมุมกล้อง CFrame ให้หันไปหาทิศทางของหัวฆาตกรโดยตรงแบบนุ่มนวลและแม่นยำ
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)
